+/** Per-server cache entries keyed by configHash: `variants[server][configHash]`. */
+export type CacheVariants = Record<string, Record<string, ServerCacheEntry>>;
+
+/** Distinct configs kept per server name; the least recently cached are dropped first. */
+export const MAX_CACHE_VARIANTS_PER_SERVER = 8;
+
+function recordVariants(variants: CacheVariants, servers: Record<string, ServerCacheEntry>): CacheVariants {
+  const next: CacheVariants = { ...variants };
+  for (const [name, entry] of Object.entries(servers)) {
+    if (!entry || typeof entry.configHash !== "string") continue;
+    const kept = Object.entries({ ...next[name], [entry.configHash]: entry })
+      .sort(([, a], [, b]) => (b.cachedAt ?? 0) - (a.cachedAt ?? 0))
+      .slice(0, MAX_CACHE_VARIANTS_PER_SERVER);
+    next[name] = Object.fromEntries(kept);
+  }
+  return next;
+}
+
+/**
+ * The cached entry for one server definition: the top-level entry when its
+ * configHash matches, else the variant recorded for that config.
+ */
+export function selectServerCacheEntry(
+  cache: (MetadataCache & { variants?: CacheVariants }) | null | undefined,
+  serverName: string,
+  definition: ServerEntry,
+  environment: NodeJS.ProcessEnv = process.env,
+): ServerCacheEntry | undefined {
+  const entry = cache?.servers[serverName];
+  let configHash: string;
+  try {
+    configHash = computeServerHash(definition, environment);
+  } catch {
+    return entry;
+  }
+  if (entry?.configHash === configHash) return entry;
+  return cache?.variants?.[serverName]?.[configHash] ?? entry;
+}
