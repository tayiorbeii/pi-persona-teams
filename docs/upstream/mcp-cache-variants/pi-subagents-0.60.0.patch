+/** The top-level entry when it matches this definition, else the variant cached for its config. */
+function selectServerCacheEntry(cache: MetadataCache, serverName: string, definition: ServerEntry): ServerCacheEntry | undefined {
+	const entry = cache.servers[serverName];
+	let configHash: string;
+	try {
+		configHash = computeMcpServerHash(definition);
+	} catch {
+		return entry;
+	}
+	if (entry?.configHash === configHash) return entry;
+	return cache.variants?.[serverName]?.[configHash] ?? entry;
