{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pi.persona-contract/v1",
  "type": "object",
  "required": ["schema", "role", "runtimeName", "authority", "requiredMethods", "activation", "completion", "providers"],
  "properties": {
    "schema": { "const": "pi.persona-contract/v1" },
    "role": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "runtimeName": { "type": "string", "pattern": "^persona-team\\." },
    "authority": { "enum": ["strategy-read-only", "planning-read-only", "implementation-writer", "independent-review-read-only", "release-prepare", "retrospective-read-only"] },
    "requiredMethods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^persona-team-" } },
    "activation": { "type": "object", "required": ["requiredBeforeSubstantiveTools", "requirePlannedApplication"] },
    "completion": { "type": "object", "required": ["requireDisposition", "allowedDispositions", "maxRepairTurns"] },
    "providers": { "type": "object", "required": ["contextMode", "jcodemunch", "nativeFallback"] }
  }
}
